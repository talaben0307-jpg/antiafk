local cloneref = cloneref or function(o) return o end
local Players = cloneref(game:GetService("Players"))
local VirtualUser = cloneref(game:GetService("VirtualUser"))
local CoreGui = cloneref(game:GetService("CoreGui"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()

local env = (getgenv and getgenv()) or _G
if env.ZenxhubAntiAfkCleanup then
    pcall(env.ZenxhubAntiAfkCleanup)
end

local function getGuiParent()
    if gethui then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, core = pcall(function() return CoreGui end)
    if ok and core then return core end
    return LocalPlayer:WaitForChild("PlayerGui", 5)
end

local parentGui = getGuiParent()
local connections = {}

local function track(conn)
    table.insert(connections, conn)
    return conn
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ZenxhubAntiAFK"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 100
ScreenGui.Parent = parentGui

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.fromOffset(230, 86)
MainFrame.Position = UDim2.new(0.02, 0, 0.82, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(11, 11, 18)
MainFrame.BackgroundTransparency = 0.08
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", MainFrame)
stroke.Thickness = 1.5
stroke.Color = Color3.fromRGB(0, 229, 255)

local TopBar = Instance.new("Frame", MainFrame)
TopBar.Size = UDim2.new(1, 0, 0, 28)
TopBar.BackgroundColor3 = Color3.fromRGB(18, 18, 28)
TopBar.BorderSizePixel = 0
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 10)

local TitleLbl = Instance.new("TextLabel", TopBar)
TitleLbl.Size = UDim2.new(1, -34, 1, 0)
TitleLbl.Position = UDim2.fromOffset(10, 0)
TitleLbl.BackgroundTransparency = 1
TitleLbl.Font = Enum.Font.GothamBold
TitleLbl.Text = "⚡ ZENXHUB | ANTI-AFK 20P"
TitleLbl.TextColor3 = Color3.fromRGB(0, 229, 255)
TitleLbl.TextSize = 11
TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

local CloseBtn = Instance.new("TextButton", TopBar)
CloseBtn.Size = UDim2.fromOffset(20, 20)
CloseBtn.Position = UDim2.new(1, -24, 0.5, -10)
CloseBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 40)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.Text = "✕"
CloseBtn.TextColor3 = Color3.fromRGB(255, 70, 90)
CloseBtn.TextSize = 10
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(1, 0)

local StatusLbl = Instance.new("TextLabel", MainFrame)
StatusLbl.Size = UDim2.new(1, -20, 0, 20)
StatusLbl.Position = UDim2.fromOffset(10, 34)
StatusLbl.BackgroundTransparency = 1
StatusLbl.Font = Enum.Font.GothamSemibold
StatusLbl.Text = "✅ Đang bật (Chống văng 20p)"
StatusLbl.TextColor3 = Color3.fromRGB(70, 220, 130)
StatusLbl.TextSize = 11
StatusLbl.TextXAlignment = Enum.TextXAlignment.Left

local TimerLbl = Instance.new("TextLabel", MainFrame)
TimerLbl.Size = UDim2.new(1, -20, 0, 18)
TimerLbl.Position = UDim2.fromOffset(10, 56)
TimerLbl.BackgroundTransparency = 1
TimerLbl.Font = Enum.Font.Gotham
TimerLbl.Text = "Thời gian treo: 00:00:00  |  Phím Z ẩn/hiện"
TimerLbl.TextColor3 = Color3.fromRGB(160, 160, 185)
TimerLbl.TextSize = 10
TimerLbl.TextXAlignment = Enum.TextXAlignment.Left

local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
track(UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

local startTime = os.clock()
local pulseCount = 0

local function triggerAntiIdle()
    pulseCount += 1
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
    StatusLbl.Text = string.format("✅ Đang chạy (Đã giữ kết nối: %d lần)", pulseCount)
end

track(LocalPlayer.Idled:Connect(function()
    triggerAntiIdle()
end))

pcall(function()
    if getconnections then
        for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
            if conn.Function then
                pcall(function() conn:Disable() end)
            end
        end
    end
end)

local active = true
task.spawn(function()
    while active do
        task.wait(1)
        if not active then break end
        local elapsed = math.floor(os.clock() - startTime)
        local h = math.floor(elapsed / 3600)
        local m = math.floor((elapsed % 3600) / 60)
        local s = elapsed % 60
        TimerLbl.Text = string.format("Treo máy: %02d:%02d:%02d | Phím Z ẩn/hiện", h, m, s)
        if elapsed > 0 and elapsed % 300 == 0 then
            triggerAntiIdle()
        end
    end
end)

track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.Z then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end))

env.ZenxhubAntiAfkCleanup = function()
    active = false
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    pcall(function() ScreenGui:Destroy() end)
    env.ZenxhubAntiAfkCleanup = nil
end

CloseBtn.MouseButton1Click:Connect(function()
    if env.ZenxhubAntiAfkCleanup then env.ZenxhubAntiAfkCleanup() end
end)
